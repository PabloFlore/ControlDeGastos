@implements IDisposable
@inherits LayoutComponentBase
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject INotificacionService NotificacionService
@inject IToastService ToastService
@inject IPinLockService PinLockService
@inject IUpdateService UpdateService
@inject ILogger<MainLayout> Logger
@inject NavigationManager Navigation

<div class="page">
    @if (!sidebarOpen)
    {
        <button class="mobile-hamburger" @onclick="ToggleSidebar" title="Abrir menú">
            ☰
        </button>
    }

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <div class="sidebar @(sidebarOpen ? "open" : "")">
        <NavMenu SidebarOpen="@sidebarOpen" OnToggle="@ToggleSidebar" OnClose="@CerrarSidebar" />
    </div>

    @if (sidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="CerrarSidebar" @ontouchstart="CerrarSidebar"></div>
    }
</div>

<BlazoredToasts />

@if (hayActualizacion)
{
    <div class="update-banner">
        <span class="update-banner-texto">🔄 Hay una actualización disponible</span>
        <div class="update-banner-acciones">
            <button class="update-banner-btn" @onclick="AceptarActualizacionAsync">Actualizar</button>
            <button class="update-banner-cerrar" @onclick="CerrarBannerAsync">✕</button>
        </div>
    </div>
}

@code {
    private bool sidebarOpen;
    private bool hayActualizacion;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CerrarSidebar()
    {
        sidebarOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var claseBody = await ThemeService.ObtenerClaseBodyAsync();
            if (!string.IsNullOrEmpty(claseBody))
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.add", claseBody);
            }

            await InicializarLockScreenAsync();
            await MostrarNotificacionesAsync();
            await VerificarActualizacionAsync();

            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registrarVisibilidad", _dotNetRef);
        }
    }

    private async Task InicializarLockScreenAsync()
    {
        try
        {
            if (!await PinLockService.EstaConfiguradoAsync()) return;

            _dotNetRef = DotNetObjectReference.Create(this);
            var delay = await PinLockService.ObtenerDelayBloqueoSegundosAsync();
            await JSRuntime.InvokeVoidAsync("pinLock.iniciar", _dotNetRef, delay);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al inicializar lock screen");
        }
    }

    [JSInvokable]
    public void CerrarSesion()
    {
        PinLockService.CerrarSesion();
        _ = InvokeAsync(() =>
        {
            Navigation.NavigateTo("/pin-unlock", replace: true);
        });
    }

    [JSInvokable]
    public async Task OnPageVisibleAsync()
    {
        await VerificarActualizacionAsync();
    }

    private async Task VerificarActualizacionAsync()
    {
        try
        {
            var cerrado = await JSRuntime.InvokeAsync<bool>("localStorage.getItem", "updateBannerCerrado");
            if (cerrado) return;

            hayActualizacion = await UpdateService.HayActualizacionPendienteAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "No se pudo verificar actualización");
        }
    }

    private async Task CerrarBannerAsync()
    {
        hayActualizacion = false;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "updateBannerCerrado", "true");
    }

    private async Task AceptarActualizacionAsync()
    {
        await UpdateService.ForzarRecargaAsync();
    }

    private async Task MostrarNotificacionesAsync()
    {
        try
        {
            var notificaciones = await NotificacionService.VerificarNotificacionesAsync();
            foreach (var n in notificaciones)
            {
                var mensaje = $"{n.Icono} {n.Mensaje}";
                if (n.Tipo == "presupuesto_excedido")
                    ToastService.ShowError(mensaje);
                else if (n.Tipo == "presupuesto_alerta")
                    ToastService.ShowWarning(mensaje);
                else
                    ToastService.ShowInfo(mensaje);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al verificar notificaciones");
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
