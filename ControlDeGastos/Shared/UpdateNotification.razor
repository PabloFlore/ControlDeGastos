@if (Visible)
{
    <div class="onboarding-overlay">
        <div class="onboarding-card">
            <div class="onboarding-contenido">
                <div class="onboarding-icono">🚀</div>
                <h3 class="onboarding-titulo">Nueva versión disponible</h3>
                <p class="onboarding-texto">
                    Hay una actualización con mejoras y correcciones.
                </p>
                <p class="onboarding-texto info-sub" style="margin-top:0.5rem">
                    Tus datos no se perderán al actualizar.
                </p>
            </div>
            <div class="onboarding-footer" style="justify-content:center;flex-direction:column;gap:0.5rem">
                <button class="onboarding-btn onboarding-comenzar" @onclick="OnActualizarAhora" style="width:100%">
                    🔄 Actualizar ahora
                </button>
                <button class="onboarding-btn onboarding-saltar" @onclick="OnMasTarde" style="width:100%">
                    Más tarde
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnActualizarAhora { get; set; }
    [Parameter] public EventCallback OnMasTarde { get; set; }
}
