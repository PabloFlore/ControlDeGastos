@if (Visible)
{
    <div class="onboarding-overlay">
        <div class="onboarding-card">
            @if (ModoAvisoPrivacidad)
            {
                <div class="onboarding-contenido">
                    <div class="onboarding-icono">🛡️</div>
                    <h3 class="onboarding-titulo">Tu privacidad primero</h3>
                    <p class="onboarding-texto">
                        Todos tus datos financieros se guardan <strong>ÚNICAMENTE</strong> en este dispositivo.
                    </p>
                    <p class="onboarding-texto" style="margin-top:0.75rem">
                        Nadie — ni la app, ni servidores externos — tiene acceso a tu información financiera.
                        Tú tienes el control total.
                    </p>
                </div>
                <div class="onboarding-footer" style="justify-content:center">
                    <button class="onboarding-btn onboarding-comenzar" @onclick="OnAceptarPrivacidad">
                        Entendido, quiero continuar
                    </button>
                </div>
            }
            else
            {
                <div class="onboarding-step-indicator">
                    @for (int i = 0; i < pasos.Count; i++)
                    {
                        <span class="onboarding-dot @(i == pasoActual ? "dot-activo" : (i < pasoActual ? "dot-completado" : ""))"></span>
                    }
                </div>

                <div class="onboarding-contenido">
                    <div class="onboarding-icono">@pasos[pasoActual].Icono</div>
                    <h3 class="onboarding-titulo">@pasos[pasoActual].Titulo</h3>
                    <p class="onboarding-texto">@pasos[pasoActual].Texto</p>
                    @if (!string.IsNullOrEmpty(pasos[pasoActual].Demo))
                    {
                        <div class="onboarding-demo">@((MarkupString)pasos[pasoActual].Demo)</div>
                    }
                </div>

                <div class="onboarding-footer">
                    <button class="onboarding-btn onboarding-saltar" @onclick="OnSaltar">Saltar tutorial</button>
                    <div class="onboarding-footer-der">
                        @if (pasoActual > 0)
                        {
                            <button class="onboarding-btn onboarding-anterior" @onclick="Anterior">Anterior</button>
                        }
                        @if (pasoActual < pasos.Count - 1)
                        {
                            <button class="onboarding-btn onboarding-siguiente" @onclick="Siguiente">Siguiente</button>
                        }
                        else
                        {
                            <button class="onboarding-btn onboarding-comenzar" @onclick="OnCompletar">¡Comenzar!</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

