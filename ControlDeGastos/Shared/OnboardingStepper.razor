    private int pasoActual = 0;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool ModoAvisoPrivacidad { get; set; }
    [Parameter] public EventCallback OnSaltar { get; set; }
    [Parameter] public EventCallback OnCompletar { get; set; }
    [Parameter] public EventCallback OnAceptarPrivacidad { get; set; }

    private void Siguiente()
    {
        if (pasoActual < pasos.Count - 1)
            pasoActual++;
    }

    private void Anterior()
    {
        if (pasoActual > 0)
            pasoActual--;
    }
}
