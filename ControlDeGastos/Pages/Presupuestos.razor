@page "/presupuestos"
@inject IPresupuestoService PresupuestoService
@inject ICategoriaService CategoriaService
@inject IGastoService GastoService
@inject IToastService ToastService

<PageTitle>Presupuestos - Control de Gastos</PageTitle>

<div class="presupuestos-page">
    <div class="page-header">
        <h1 class="page-titulo">Presupuestos</h1>
        <p class="page-sub">@NombresMes[DateTime.Now.Month - 1] @DateTime.Now.Year</p>
    </div>

    <div class="presupuestos-lista">
        @if (items is null)
        {
            <LoadingSpinner Message="Cargando presupuestos..." />
        }
        else if (!items.Any())
        {
            <EmptyState Icon="🎯" Title="Sin presupuestos" Subtitle="Crea uno para controlar tus gastos por categoría" />
        }
        else
        {
            @foreach (var item in items)
            {
                <div @key="item.Id" class="presupuesto-card @(item.EsVencido ? "presupuesto-vencido" : "")">
                    <div class="presupuesto-top">
                        <div class="presupuesto-categoria">
                            <div class="presupuesto-icono" style="background: @(item.Color + "22")">
                                @item.Icono
                            </div>
                            <div>
                                <div class="presupuesto-nombre">@item.Nombre @(item.EsVencido ? "⏰" : "")</div>
                                <div class="presupuesto-periodo">@LabelPeriodo(item.Periodo)</div>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button class="btn-editar" @onclick="() => AbrirModalEditar(item)">✏️</button>
                            <button class="btn-eliminar" @onclick="() => ConfirmarEliminar(item.Id)">🗑️</button>
                        </div>
                    </div>

                    <div class="presupuesto-bar-wrapper">
                        <div class="presupuesto-bar">
                            <div class="presupuesto-fill @ClaseColor(item.Porcentaje)"
                                 style="width: @Math.Min(100, item.Porcentaje)%"></div>
                        </div>
                    </div>

                    <div class="presupuesto-datos">
                        <div class="dato-item">
                            <span class="dato-label">Gastado</span>
                            <span class="dato-valor @(item.Porcentaje > 100 ? "texto-rojo" : "")">@FormatearMonto(item.Gastado)</span>
                        </div>
                        <div class="dato-item">
                            <span class="dato-label">Límite</span>
                            <span class="dato-valor">@FormatearMonto(item.MontoLimite)</span>
                        </div>
                        <div class="dato-item">
                            <span class="dato-label">Restante</span>
                            <span class="dato-valor @(item.Restante >= 0 ? "texto-verde" : "texto-rojo")">@FormatearMonto(item.Restante)</span>
                        </div>
                    </div>

                    @if (item.Gastado > item.MontoLimite)
                    {
                        <div class="presupuesto-alerta alerta-excedido">
                            ⚡ Te excediste por @FormatearMonto(Math.Abs(item.Restante))
                        </div>
                    }
                    else if (item.Porcentaje >= 80)
                    {
                        <div class="presupuesto-alerta alerta-atencion">
                            ⚡ Te queda @FormatearMonto(item.Restante)
                        </div>
                    }
                </div>
            }

            <div class="total-general">
                <div class="total-row">
                    <span>Total presupuestado</span>
                    <span>@FormatearMonto(items.Sum(i => i.MontoLimite))</span>
                </div>
                <div class="total-row">
                    <span>Total gastado</span>
                    <span class="texto-rojo">@FormatearMonto(items.Sum(i => i.Gastado))</span>
                </div>
                <div class="total-row total-final">
                    <span>Balance</span>
                    @{
                        var balanceTotal = items.Sum(i => i.MontoLimite) - items.Sum(i => i.Gastado);
                    }
                    <span class="@(balanceTotal >= 0 ? "texto-verde" : "texto-rojo")">@FormatearMonto(balanceTotal)</span>
                </div>
            </div>
        }
    </div>

    <button class="fab-button" @onclick="AbrirModalNuevo" title="Agregar presupuesto">+</button>
</div>

<Modal Title="@(formEditandoId is null ? "Nuevo presupuesto" : "Editar presupuesto")" Visible="@modalAbierto" OnClose="CerrarModal">
    <Body>
        <div class="campo">
            <label class="campo-label">Categoría</label>
            <select class="campo-input" value="@formCategoriaId" @onchange="OnCategoriaChanged">
                <option value="@Guid.Empty">— Todas las categorías —</option>
                @foreach (var cat in categoriasGasto)
                {
                    <option value="@cat.Id">@cat.Icono @cat.Nombre</option>
                }
            </select>
        </div>

        <div class="campo">
            <label class="campo-label">Periodo</label>
            <div class="periodo-toggle">
                @foreach (var p in Enum.GetValues<PeriodoPresupuesto>())
                {
                    <button class="periodo-btn @(formPeriodo == p ? "periodo-activo" : "")"
                            @onclick="() => formPeriodo = p">
                        @LabelPeriodo(p)
                    </button>
                }
            </div>
        </div>

        <div class="campo">
            <label class="campo-label">Límite de gasto</label>
            <div class="monto-input-wrapper">
                <span class="monto-simbolo">$</span>
                <input type="number"
                       class="monto-input"
                       @bind="formMonto"
                       step="0.01"
                       min="0.01"
                       placeholder="0.00" />
            </div>
            @if ((formMonto ?? 0) <= 0)
            {
                <span class="campo-error">El límite debe ser mayor a 0</span>
            }
        </div>

        <div class="campo">
            <label class="campo-label">Fecha de inicio</label>
            <input type="date" class="campo-input" @bind="formFecha" @bind:format="yyyy-MM-dd" />
        </div>
    </Body>
    <Footer>
        <button class="btn-footer btn-cancelar" @onclick="CerrarModal">Cancelar</button>
        <button class="btn-footer btn-guardar" @onclick="GuardarAsync" disabled="@(!FormularioValido || guardando)">
            @(guardando ? "Guardando..." : "Guardar")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="@(eliminandoId is not null)"
               Icon="⚠️"
               Title="¿Eliminar este presupuesto?"
               Message="Los gastos asociados no se eliminarán"
               CancelText="Cancelar"
               ConfirmText="Eliminar"
               OnCancel="CancelarEliminar"
               OnConfirm="EliminarAsync" />

@code {
    private List<PresupuestoItem>? items;
    private List<Categoria> categoriasGasto = new();

    private bool modalAbierto;
    private Guid formCategoriaId = Guid.Empty;
    private PeriodoPresupuesto formPeriodo = PeriodoPresupuesto.Mensual;
    private decimal? formMonto;
    private DateTime formFecha = DateTime.Now;
    private bool guardando;

    private Guid? formEditandoId;
    private Guid? eliminandoId;

    private bool FormularioValido => (formMonto ?? 0) > 0;

    private static readonly string[] NombresMes =
        ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
         "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var categorias = await CategoriaService.ObtenerCategoriasAsync();
            categoriasGasto = categorias.Where(c => c.Tipo == TipoGasto.Gasto).OrderBy(c => c.Orden).ToList();

            var presupuestos = await PresupuestoService.ObtenerPresupuestosAsync();
            var todosGastos = await GastoService.ObtenerGastosAsync();
            todosGastos = await PresupuestoService.FiltrarGastosParaPresupuestoAsync(todosGastos);
            var ahora = DateTime.UtcNow;
            var activos = new List<PresupuestoItem>();
            var vencidos = new List<PresupuestoItem>();

            foreach (var p in presupuestos)
            {
                var cat = p.CategoriaId.HasValue
                    ? categorias.FirstOrDefault(c => c.Id == p.CategoriaId.Value)
                    : null;

                var fin = p.FechaFin ?? (p.Periodo switch
                {
                    PeriodoPresupuesto.Mensual => p.FechaInicio.AddMonths(1),
                    PeriodoPresupuesto.Anual => p.FechaInicio.AddYears(1),
                    _ => p.FechaInicio.AddDays(7)
                });

                var gastado = await PresupuestoService.CalcularGastadoAsync(p, todosGastos);
                var item = new PresupuestoItem
                {
                    Id = p.Id,
                    CategoriaId = p.CategoriaId,
                    Nombre = cat?.Nombre ?? "General",
                    Icono = cat?.Icono ?? "📊",
                    Color = cat?.Color ?? "#6c757d",
                    Periodo = p.Periodo,
                    MontoLimite = p.MontoLimite,
                    Gastado = gastado,
                    EsVencido = ahora < p.FechaInicio || ahora > fin,
                };

                if (item.EsVencido)
                    vencidos.Add(item);
                else
                    activos.Add(item);
            }

            items = activos.Concat(vencidos).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar: {ex.Message}");
            items = new();
        }

        StateHasChanged();
    }

    private void OnCategoriaChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var guid))
        {
            formCategoriaId = guid;
            var cat = categoriasGasto.FirstOrDefault(c => c.Id == guid);
            // Auto-llena el monto con el PresupuestoPorDefecto de la categoría (útil para gastos fijos como renta, servicios, suscripciones)
            if (cat?.PresupuestoPorDefecto > 0 && (formMonto ?? 0) <= 0)
                formMonto = cat.PresupuestoPorDefecto;
        }
    }

    private void AbrirModalNuevo()
    {
        formEditandoId = null;
        formCategoriaId = Guid.Empty;
        formPeriodo = PeriodoPresupuesto.Mensual;
        formMonto = null;
        formFecha = DateTime.Now;
        modalAbierto = true;
    }

    private void AbrirModalEditar(PresupuestoItem item)
    {
        formEditandoId = item.Id;
        formCategoriaId = item.CategoriaId ?? Guid.Empty;
        formPeriodo = item.Periodo;
        formMonto = item.MontoLimite;
        formFecha = DateTime.Now;
        modalAbierto = true;
    }

    private void CerrarModal()
    {
        modalAbierto = false;
        guardando = false;
        formEditandoId = null;
    }

    private async Task GuardarAsync()
    {
        if (!FormularioValido) return;

        guardando = true;
        StateHasChanged();

        try
        {
            if (formEditandoId is not null)
            {
                var presupuestos = await PresupuestoService.ObtenerPresupuestosAsync();
                var existente = presupuestos.FirstOrDefault(p => p.Id == formEditandoId);
                if (existente is null)
                {
                    ToastService.ShowError("Presupuesto no encontrado");
                    return;
                }

                existente.CategoriaId = formCategoriaId == Guid.Empty ? null : formCategoriaId;
                existente.MontoLimite = formMonto ?? 0;
                existente.Periodo = formPeriodo;
                existente.FechaInicio = formFecha.ToUniversalTime();

                await PresupuestoService.ActualizarPresupuestoAsync(existente);
                ToastService.ShowSuccess("Presupuesto actualizado");
            }
            else
            {
                var presupuesto = new Presupuesto
                {
                    CategoriaId = formCategoriaId == Guid.Empty ? null : formCategoriaId,
                    MontoLimite = formMonto ?? 0,
                    Periodo = formPeriodo,
                    FechaInicio = formFecha.ToUniversalTime(),
                };

                await PresupuestoService.CrearPresupuestoAsync(presupuesto);
                ToastService.ShowSuccess("Presupuesto creado");
            }

            CerrarModal();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }

        guardando = false;
    }

    private void ConfirmarEliminar(Guid id)
    {
        eliminandoId = id;
    }

    private void CancelarEliminar()
    {
        eliminandoId = null;
    }

    private async Task EliminarAsync()
    {
        if (eliminandoId is null) return;

        try
        {
            await PresupuestoService.EliminarPresupuestoAsync(eliminandoId.Value);
            ToastService.ShowSuccess("Presupuesto eliminado");
            CancelarEliminar();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string LabelPeriodo(PeriodoPresupuesto p) => p switch
    {
        PeriodoPresupuesto.Semanal => "Semanal",
        PeriodoPresupuesto.Mensual => "Mensual",
        PeriodoPresupuesto.Anual => "Anual",
        _ => ""
    };

    private string ClaseColor(int pct) => pct switch
    {
        > 100 => "fill-peligro",
        >= 80 => "fill-atencion",
        >= 60 => "fill-cuidado",
        _ => "fill-bien"
    };

    private string FormatearMonto(decimal monto)
    {
        var prefijo = monto < 0 ? "-" : "";
        return $"{prefijo}${Math.Abs(monto):N2}";
    }

    private class PresupuestoItem
    {
        public Guid Id { get; set; }
        public Guid? CategoriaId { get; set; }
        public string Nombre { get; set; } = "";
        public string Icono { get; set; } = "📁";
        public string Color { get; set; } = "#6c757d";
        public PeriodoPresupuesto Periodo { get; set; }
        public decimal MontoLimite { get; set; }
        public decimal Gastado { get; set; }
        public decimal Restante => MontoLimite - Gastado;
        public int Porcentaje => MontoLimite > 0 ? (int)Math.Round(Math.Min(200, Gastado * 100 / MontoLimite)) : 0;
        public bool EsVencido { get; set; }
    }
}
