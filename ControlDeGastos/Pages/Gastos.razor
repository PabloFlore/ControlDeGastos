    private void EditarGasto(Gasto gasto)
    {
        if (gasto.RecurrenciaId is not null)
        {
            ToastService.ShowWarning("🔄 Este gasto solo puede editarse desde la sección de Recurrencias");
            return;
        }
        if (gasto.FinanciamientoId is not null)
        {
            ToastService.ShowWarning("💳 Este gasto solo puede editarse desde la sección de Financiamiento");
            return;
        }
        editando = true;
        gastoFormMonto = Math.Abs(gasto.Monto);
        gastoForm = new Gasto
        {
            Id = gasto.Id,
            CategoriaId = gasto.CategoriaId,
            Monto = Math.Abs(gasto.Monto),
            Descripcion = gasto.Descripcion,
            EsGastoCompartido = gasto.EsGastoCompartido,
            UsuarioId = gasto.UsuarioId,
            HogarId = gasto.HogarId,
            CreadoEn = gasto.CreadoEn,
            Sincronizado = gasto.Sincronizado,
            ActualizadoEn = gasto.ActualizadoEn,
            Fecha = gasto.Fecha
        };
        fechaForm = gasto.Fecha.ToLocalTime();
        tipoForm = gasto.Monto >= 0 ? "Gasto" : "Ingreso";
        montoTocado = false;
        modalAbierto = true;
    }

    private void CerrarModal()
    {
        modalAbierto = false;
        guardando = false;
        montoTocado = false;
    }

    private async Task GuardarGastoAsync()
    {
        if (!FormularioValido) return;

        guardando = true;
        StateHasChanged();

        var montoOriginal = gastoFormMonto ?? 0;

        try
        {
            gastoForm.Monto = tipoForm == "Gasto"
                ? Math.Abs(gastoFormMonto ?? 0)
                : -Math.Abs(gastoFormMonto ?? 0);
            gastoForm.Fecha = fechaForm.ToUniversalTime();

            if (editando)
            {
                await GastoService.ActualizarGastoAsync(gastoForm);
                ToastService.ShowSuccess("Gasto actualizado");
            }
            else
            {
                var nivelAntes = 1;
                var hpAntes = 100;
                var monedasAntes = 0;
                usuario = await UsuarioService.ObtenerUsuarioAsync();
                if (usuario?.ModoGamificadoActivo == true)
                {
                    var p = await GamificacionService.ObtenerProgresoAsync();
                    nivelAntes = p.Nivel;
                    hpAntes = p.HpActual;
                    monedasAntes = p.Monedas;
                }

                await GastoService.CrearGastoAsync(gastoForm);
                ToastService.ShowSuccess(tipoForm == "Gasto" ? "Gasto registrado" : "Salario ingresado");

                usuario = await UsuarioService.ObtenerUsuarioAsync();
                if (usuario?.ModoGamificadoActivo == true)
                {
                    var nuevosLogros = await GamificacionService.VerificarYDesbloquearLogrosAsync();
                    foreach (var logro in nuevosLogros)
                    {
                        ToastService.ShowSuccess($"🏅 ¡Logro desbloqueado: {logro.Nombre}!");
                    }

                    var p = await GamificacionService.ObtenerProgresoAsync();
                    if (p.Nivel > nivelAntes)
                    {
                        await JSRuntime.InvokeVoidAsync("rpgEffects.levelUpFlash");
                        ToastService.ShowSuccess($"🎉 ¡Subiste al nivel {p.Nivel}!");
                    }
                    if (p.HpActual < hpAntes)
                    {
                        await JSRuntime.InvokeVoidAsync("rpgEffects.damageFlash");
                        ToastService.ShowWarning($"💔 Perdiste {hpAntes - p.HpActual} HP");
                    }
                    if (p.Monedas > monedasAntes)
                    {
                        ToastService.ShowSuccess($"🪙 ¡Ganaste {p.Monedas - monedasAntes} monedas!");
                    }
                }
            }

            gastoForm.Monto = montoOriginal;
            CerrarModal();
            await CargarGastosAsync();
        }
        catch (InvalidOperationException ex)
        {
            gastoForm.Monto = montoOriginal;
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            gastoForm.Monto = montoOriginal;
            ToastService.ShowError($"Error al guardar: {ex.Message}");
        }

        guardando = false;
    }

    private void ConfirmarEliminar(Guid id)
    {
        gastoEliminando = id;
    }

    private void CancelarEliminar()
