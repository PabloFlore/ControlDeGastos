    private async Task ExportarAsync(string alcance)
    {
        exportMenuAbierto = false;
        if (exportando) return;
        exportando = true;
        StateHasChanged();

        try
        {
            var gastosExportar = await ObtenerGastosPorAlcanceAsync(alcance);
            var usuario = await UsuarioService.ObtenerUsuarioAsync();
            var moneda = usuario?.Moneda ?? "MXN";
            var simbolo = moneda switch { "USD" => "$", "EUR" => "€", _ => "$" };
            var nomMes = NombresMes[mesSeleccionado - 1];

            var registros = gastosExportar
                .OrderBy(g => g.Fecha)
                .Select(g => new
                {
                    fecha = g.Fecha.ToLocalTime().ToString("yyyy-MM-dd"),
                    monto = g.Monto,
                    categoria = categorias.FirstOrDefault(c => c.Id == g.CategoriaId)?.Nombre ?? "Sin categoría",
                    descripcion = g.Descripcion ?? ""
                })
                .ToList();

            var totalGastos = gastosExportar.Where(g => g.Monto >= 0).Sum(g => g.Monto);
            var totalIngresos = gastosExportar.Where(g => g.Monto < 0).Sum(g => Math.Abs(g.Monto));

            await JSRuntime.InvokeVoidAsync("generarExcel",
                registros, nomMes, añoSeleccionado, simbolo, totalGastos, totalIngresos);

            ToastService.ShowSuccess($"Exportados {gastosExportar.Count} registros en Excel");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al exportar: {ex.Message}");
        }

        exportando = false;
    }

    private async Task<List<Gasto>> ObtenerGastosPorAlcanceAsync(string alcance)
    {
        switch (alcance)
        {
            case "Este mes":
                return await GastoService.ObtenerGastosPorMesAsync(añoSeleccionado, mesSeleccionado);
            case "Últimos 3 meses":
                var todos = await GastoService.ObtenerGastosAsync();
                return todos.Where(g => g.Fecha >= DateTime.UtcNow.AddMonths(-3)).ToList();
            case "Este año":
                var totales = await GastoService.ObtenerGastosAsync();
                return totales.Where(g => g.Fecha.Year == DateTime.UtcNow.Year).ToList();
            default:
                return await GastoService.ObtenerGastosAsync();
        }
    }

