    private void CerrarModalRecurrencias()
    {
        modalRecurrenciasAbierto = false;
        StateHasChanged();
    }

    private void AbrirModalNuevaRecurrencia()
    {
        editandoRecurrencia = false;
        editandoRecurrenciaId = null;
        recurrenciaFormCategoriaId = Guid.Empty;
        recurrenciaFormMonto = null;
        recurrenciaFormDesc = "";
        recurrenciaFormPeriodo = "Mensual";
        recurrenciaFormActiva = true;
        modalRecurrenciaFormAbierto = true;
    }

    private void EditarRecurrencia(Recurrencia rec)
    {
        editandoRecurrencia = true;
        editandoRecurrenciaId = rec.Id;
        recurrenciaFormCategoriaId = rec.CategoriaId ?? Guid.Empty;
        recurrenciaFormMonto = rec.Monto;
        recurrenciaFormDesc = rec.Descripcion ?? "";
        recurrenciaFormPeriodo = rec.TipoRecurrencia switch
        {
            Models.TipoRecurrencia.Diario => "Diario",
            Models.TipoRecurrencia.Semanal => "Semanal",
            Models.TipoRecurrencia.Mensual => "Mensual",
            Models.TipoRecurrencia.Anual => "Anual",
            _ => "Mensual"
        };
        recurrenciaFormActiva = rec.Activa;
        modalRecurrenciaFormAbierto = true;
    }

    private void CerrarModalRecurrenciaForm()
    {
        modalRecurrenciaFormAbierto = false;
        guardandoRecurrencia = false;
        editandoRecurrenciaId = null;
    }

    private async Task GuardarRecurrenciaAsync()
    {
        if (!RecurrenciaFormValida) return;

        guardandoRecurrencia = true;
        StateHasChanged();

        try
        {
            var tipo = recurrenciaFormPeriodo switch
            {
                "Diario" => Models.TipoRecurrencia.Diario,
                "Semanal" => Models.TipoRecurrencia.Semanal,
                "Mensual" => Models.TipoRecurrencia.Mensual,
                "Anual" => Models.TipoRecurrencia.Anual,
                _ => Models.TipoRecurrencia.Mensual
            };

            if (editandoRecurrenciaId.HasValue)
            {
                var recurrenciasList = await RecurrenciaService.ObtenerRecurrenciasAsync();
                var existente = recurrenciasList.FirstOrDefault(r => r.Id == editandoRecurrenciaId);
                if (existente != null)
                {
                    existente.CategoriaId = recurrenciaFormCategoriaId;
                    existente.Monto = recurrenciaFormMonto ?? 0;
                    existente.Descripcion = string.IsNullOrWhiteSpace(recurrenciaFormDesc) ? null : recurrenciaFormDesc.Trim();
                    existente.TipoRecurrencia = tipo;
                    existente.Activa = recurrenciaFormActiva;
                    await RecurrenciaService.ActualizarRecurrenciaAsync(existente);
                    ToastService.ShowSuccess("Recurrencia actualizada");
                }
            }
            else
            {
                var rec = new Recurrencia
                {
                    CategoriaId = recurrenciaFormCategoriaId,
                    Monto = recurrenciaFormMonto ?? 0,
                    Descripcion = string.IsNullOrWhiteSpace(recurrenciaFormDesc) ? null : recurrenciaFormDesc.Trim(),
                    TipoRecurrencia = tipo,
                    FechaInicio = DateTime.UtcNow,
                    ProximaFecha = DateTime.UtcNow,
                    Activa = recurrenciaFormActiva,
                };
                await RecurrenciaService.CrearRecurrenciaAsync(rec);
                ToastService.ShowSuccess("Recurrencia creada");
            }

            var generados = await RecurrenciaService.GenerarPendientesAsync();
            if (generados.Count > 0)
            {
                ToastService.ShowSuccess($"💸 Gasto generado: {generados[0].Descripcion ?? "recurrencia"}");
            }

            await CargarRecurrenciasAsync();
            await CargarGastosAsync();
            CerrarModalRecurrenciaForm();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }

        guardandoRecurrencia = false;
    }

    private void ConfirmarEliminarRecurrencia(Guid id)
    {
        recurrenciaEliminandoId = id;
    }

    private void CancelarEliminarRecurrencia()
    {
        recurrenciaEliminandoId = null;
    }

    private async Task EliminarRecurrenciaAsync()
    {
        if (recurrenciaEliminandoId is null) return;

        try
        {
            await RecurrenciaService.EliminarRecurrenciaAsync(recurrenciaEliminandoId.Value);
            ToastService.ShowSuccess("Recurrencia eliminada. Los gastos anteriores se conservan.");
            CancelarEliminarRecurrencia();
            await CargarRecurrenciasAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task EliminarRecurrenciaConGastosAsync()
    {
        if (recurrenciaEliminandoId is null) return;

        try
        {
            var id = recurrenciaEliminandoId.Value;
            await RecurrenciaService.EliminarRecurrenciaConGastosAsync(id);
            ToastService.ShowSuccess("Recurrencia y sus gastos eliminados");
            CancelarEliminarRecurrencia();
            await CargarRecurrenciasAsync();
            await CargarGastosAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        ctsCarga?.Cancel();
        if (ctsCarga != null)
        {
            ctsCarga.Dispose();
            ctsCarga = null;
        }
        await Task.CompletedTask;
    }

    private static DateTime SafeLocalTime(DateTime dt)
    {
        if (dt.Kind == DateTimeKind.Unspecified)
            return DateTime.SpecifyKind(dt, DateTimeKind.Utc).ToLocalTime();
        return dt.ToLocalTime();
    }
}
