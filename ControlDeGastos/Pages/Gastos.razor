@page "/gastos"
@implements IAsyncDisposable
@inject IGastoService GastoService
@inject ICategoriaService CategoriaService
@inject IUsuarioService UsuarioService
@inject ILicenciaService LicenciaService
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IGamificacionService GamificacionService
@inject ITiendaService TiendaService
@inject IRecurrenciaService RecurrenciaService
@inject IPresupuestoService PresupuestoService
@* @inject IHogarService HogarService *@
@inject ILogger<Gastos> Logger
 
<PageTitle>Gastos - Control de Gastos</PageTitle>

<div class="gastos-page">
    <div class="mes-selector">
        <button class="mes-btn" @onclick="MesAnterior" title="Mes anterior">‹</button>
        <span class="mes-titulo">@NombresMes[mesSeleccionado - 1] @añoSeleccionado</span>
        <button class="mes-btn @(EsMesActual ? "btn-deshabilitado" : "")" @onclick="MesSiguiente" title="Mes siguiente">›</button>
        @if (mesSeleccionado != DateTime.Now.Month || añoSeleccionado != DateTime.Now.Year)
        {
            <button class="mes-btn hoy-btn" @onclick="IrAlMesActual" title="Volver al mes actual">●</button>
        }
    </div>

    <div class="acciones-barra">
        <button class="accion-boton recurrencia-btn" @onclick="AbrirModalRecurrencias" title="Transacciones recurrentes">
            🔄 Recurrentes <span class="recurrencia-badge">@recurrenciasActivas</span>
        </button>
        <div class="export-wrapper">
            <button class="accion-boton export-btn" @onclick="ToggleExportMenu" title="Exportar datos">
                📥 Exportar
            </button>
            @if (exportMenuAbierto)
            {
                <div class="export-menu">
                    <button class="export-opcion export-opcion-formato" @onclick='() => ExportarAsync("Este mes")'>📊 Excel — Este mes</button>
                    <button class="export-opcion export-opcion-formato" @onclick='() => ExportarAsync("Últimos 3 meses")'>📊 Excel — Últimos 3 meses</button>
                    <button class="export-opcion export-opcion-formato" @onclick='() => ExportarAsync("Este año")'>📊 Excel — Este año</button>
                    <button class="export-opcion export-opcion-formato" @onclick='() => ExportarAsync("Todo")'>📊 Excel — Todo</button>
                </div>
            }
        </div>
    </div>

    <div class="resumen-grid">
        <div class="resumen-card resumen-gastos">
            <div class="resumen-label">Gastos</div>
            <div class="resumen-valor">@FormatearMonto(totalGastos)</div>
        </div>
        <div class="resumen-card resumen-ingresos">
            <div class="resumen-label">Ingresos</div>
            <div class="resumen-valor">@FormatearMonto(totalIngresos)</div>
        </div>
        <div class="resumen-card resumen-balance-mes">
            <div class="resumen-label">Balance del mes</div>
            <div class="resumen-valor @(balanceMes >= 0 ? "texto-positivo" : "texto-negativo")">@(balanceMes < 0 ? "-" : "")@FormatearMonto(balanceMes)</div>
        </div>
        <div class="resumen-card resumen-balance-total">
            <div class="resumen-label">Balance total</div>
            <div class="resumen-valor @(balanceAcumulado >= 0 ? "texto-positivo" : "texto-negativo")">@(balanceAcumulado < 0 ? "-" : "")@FormatearMonto(balanceAcumulado)</div>
        </div>
    </div>

    @if (gastosAgrupados is not null && gastosAgrupados.Any())
    {
        <div class="filtros-bar">
            <div class="filtro-busqueda-wrapper">
                <span class="filtro-search-icon">🔍</span>
                <input type="text" class="filtro-busqueda" placeholder="Buscar en descripción..."
                       @bind="filtroBusqueda" @bind:event="oninput" @bind:after="() => OnBusquedaChanged(filtroBusqueda)" />
                @if (!string.IsNullOrEmpty(filtroBusqueda))
                {
                    <button class="filtro-clear" @onclick="LimpiarBusqueda">✕</button>
                }
            </div>
            <button class="filtro-toggle" @onclick="ToggleFiltros">
                <span class="filtro-toggle-icon">@(filtrosVisibles ? "▲" : "▼")</span>
            </button>
        </div>

        @if (filtrosVisibles)
        {
            <div class="filtro-panel">
                <div class="filtro-tipos">
                    @foreach (var tipo in new[] { "Todos", "Gasto", "Ingreso" })
                    {
                        <button class="filtro-pill @(filtroTipo == tipo ? "pill-activa" : "")"
                                @onclick="() => CambiarFiltroTipo(tipo)">
                            @tipo
                        </button>
                    }
                </div>
                @* Comentado: filtro compartido (hogar) — proximamente
                @if (usuario?.HogarId is not null)
                {
                    <div class="filtro-tipos" style="margin-top:0.4rem">
                        @foreach (var opt in new[] { "Todos", "Personales", "Compartidos" })
                        {
                            <button class="filtro-pill @(filtroCompartido == opt ? "pill-activa" : "")"
                                    @onclick="() => CambiarFiltroCompartido(opt)">
                                @(opt == "Personales" ? "👤" : opt == "Compartidos" ? "👥" : "") @opt
                            </button>
                        }
                    </div>
                }
                *@
                <div class="filtro-categorias">
                    <button class="filtro-chip @(filtroCategoriaId is null ? "chip-activa" : "")"
                            @onclick="LimpiarFiltroCategoria">
                        Todas
                    </button>
                    @foreach (var cat in categoriasFiltro)
                    {
                        <button class="filtro-chip @(filtroCategoriaId == cat.Id ? "chip-activa" : "")"
                                style="--chip-color: @cat.Color"
                                @onclick="() => CambiarFiltroCategoria(cat.Id)">
                            @cat.Icono @cat.Nombre
                        </button>
                    }
                </div>
            </div>
        }
    }

    @if (filtrosVisibles || modoRango)
    {
        <div class="filtro-rango">
            <div class="rango-campo">
                <label class="rango-label">Desde</label>
                <input type="date" class="rango-input" value="@filtroFechaDesde?.ToString("yyyy-MM-dd")" @onchange="OnFechaDesdeChanged" />
            </div>
            <div class="rango-campo">
                <label class="rango-label">Hasta</label>
                <input type="date" class="rango-input" value="@filtroFechaHasta?.ToString("yyyy-MM-dd")" @onchange="OnFechaHastaChanged" />
            </div>
            @if (modoRango)
            {
                <button class="rango-clear" @onclick="LimpiarRango" title="Limpiar rango">✕</button>
            }
        </div>
    }

    <div class="gastos-lista">
        @if (gastosAgrupados is null)
        {
            <LoadingSpinner Message="Cargando gastos..." />
        }
        else if (!gastosAgrupados.Any())
        {
            <EmptyState Icon="📭" Title="No hay gastos este mes" Subtitle="Presiona + para registrar tu primer gasto" />
        }
        else if (!gastosFiltrados.Any())
        {
            <EmptyState Icon="🔍" Title="Sin resultados" Subtitle="Prueba con otros filtros" />
        }
        else
        {
            @foreach (var grupo in gastosFiltrados)
            {
                <div class="grupo-fecha">
                    <div class="grupo-header">@FormatearFechaGrupo(grupo.Fecha)</div>
                    @foreach (var gasto in grupo.Gastos)
                    {
                        <div @key="gasto.Id" class="gasto-item @(gasto.RecurrenciaId is not null ? "gasto-recurrencia" : gasto.FinanciamientoId is not null ? "gasto-financiamiento" : "") @ObtenerClaseSkin()" data-categoria-color="@ObtenerColorCategoria(gasto.CategoriaId)">
                            @if (gasto.RecurrenciaId is not null)
                            {
                                <span class="gasto-corner corner-recurrencia"></span>
                            }
                            else if (gasto.FinanciamientoId is not null)
                            {
                                <span class="gasto-corner corner-financiamiento"></span>
                            }
                            <div class="gasto-icono" style="background-color: @(ObtenerColorCategoria(gasto.CategoriaId) + "22")">
                                <span>@ObtenerIconoCategoria(gasto.CategoriaId)</span>
                            </div>
                            <div class="gasto-info">
                                <div class="gasto-categoria">@ObtenerNombreCategoria(gasto.CategoriaId)</div>
                                @if (!string.IsNullOrEmpty(gasto.Descripcion))
                                {
                                    <div class="gasto-descripcion">@gasto.Descripcion</div>
                                }
                                <div class="gasto-meta">
                                    <span class="gasto-fecha">@gasto.Fecha.ToLocalTime().ToString(mostrarMinutos ? "dd MMM HH:mm" : "dd MMM")</span>
                                    @if (gasto.RecurrenciaId is not null)
                                    {
                                        <span class="gasto-recurrencia-badge" title="Generado por recurrencia">🔄</span>
                                    }
                                    @* Comentado: badge compartido (hogar)
                                    @if (gasto.EsGastoCompartido)
                                    {
                                        ...
                                    }
                                    *@
                                </div>
                            </div>
                            <div class="gasto-monto @(gasto.Monto >= 0 ? "monto-gasto" : "monto-ingreso")">@FormatearMonto(gasto.Monto)</div>
                            <div class="gasto-acciones">
                                <button class="accion-btn" @onclick="() => EditarGasto(gasto)" title="Editar">✏️</button>
                                <button class="accion-btn accion-eliminar" @onclick="() => ConfirmarEliminar(gasto.Id)" title="Eliminar">🗑️</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (totalPaginas > 1)
    {
        <div class="paginacion">
            <button class="pag-btn" disabled="@(paginaActual <= 1)" @onclick="() => CambiarPagina(1)" title="Primera">«</button>
            <button class="pag-btn" disabled="@(paginaActual <= 1)" @onclick="() => CambiarPagina(paginaActual - 1)" title="Anterior">‹</button>
            @{
                var inicio = Math.Max(1, paginaActual - 2);
                var fin = Math.Min(totalPaginas, inicio + 4);
                if (fin - inicio < 4) inicio = Math.Max(1, fin - 4);
                for (var p = inicio; p <= fin; p++)
                {
                    <button class="pag-btn @(p == paginaActual ? "pag-actual" : "")" @onclick="() => CambiarPagina(p)">@p</button>
                }
            }
            <button class="pag-btn" disabled="@(paginaActual >= totalPaginas)" @onclick="() => CambiarPagina(paginaActual + 1)" title="Siguiente">›</button>
            <button class="pag-btn" disabled="@(paginaActual >= totalPaginas)" @onclick="() => CambiarPagina(totalPaginas)" title="Última">»</button>
            <span class="pag-info">@paginaActual / @totalPaginas</span>
        </div>
    }
    <button class="fab-button" @onclick="AbrirModalNuevo" title="Nuevo registro">+</button>
</div>

<Modal Title="@((editando ? "Editar" : "Nuevo") + " registro")" Visible="@modalAbierto" OnClose="CerrarModal">
    <Body>
        <div class="tipo-toggle">
            <button class="tipo-btn @(tipoForm == "Gasto" ? "tipo-activo tipo-gasto" : "")"
                    @onclick="SeleccionarTipoGasto">
                💸 Gasto
            </button>
            <button class="tipo-btn @(tipoForm == "Ingreso" ? "tipo-activo tipo-ingreso" : "")"
                    @onclick="SeleccionarTipoIngreso">
                💰 Ingreso
            </button>
        </div>

        <div class="campo">
            <label class="campo-label">Categoría</label>
            <div class="categoria-grid">
                @foreach (var cat in categoriasFiltradas)
                {
                    <div class="categoria-item @(gastoForm.CategoriaId == cat.Id ? "cat-seleccionada" : "")"
                         style="--cat-color: @cat.Color"
                         @onclick="() => gastoForm.CategoriaId = cat.Id">
                        <span class="cat-icono">@cat.Icono</span>
                        <span class="cat-nombre">@cat.Nombre</span>
                    </div>
                }
                @if (!categoriasFiltradas.Any())
                {
                    <p class="campo-error">No hay categorías disponibles</p>
                }
            </div>
            @if (!categoriasFiltradas.Any(c => c.Id == gastoForm.CategoriaId))
            {
                <span class="campo-error">Selecciona una categoría</span>
            }
        </div>

        <div class="campo">
            <label class="campo-label">Monto</label>
            <div class="monto-input-wrapper">
                <span class="monto-simbolo">$</span>
                <input type="number"
                       class="monto-input"
                       @bind="gastoFormMonto"
                       @bind:event="oninput"
                       @onfocus="() => montoTocado = true"
                       step="0.01"
                       placeholder="0.00" />
            </div>
            @if (montoTocado && (gastoFormMonto ?? 0) <= 0)
            {
                <span class="campo-error">El monto debe ser mayor a 0</span>
            }
        </div>

        <div class="campo">
            <label class="campo-label">Descripción <span class="campo-opcional">(opcional)</span></label>
            <input type="text" class="campo-input" @bind="gastoForm.Descripcion" placeholder="@(tipoForm == "Gasto" ? "¿En qué gastaste?" : "Descripción del ingreso")" />
        </div>

        <div class="campo">
            <label class="campo-label">Fecha</label>
            <input type="date" class="campo-input" @bind="fechaForm" />
        </div>

        @* Comentado: checkbox compartir (hogar) — proximamente
        @if (usuario?.HogarId is not null)
        {
            <div class="campo-checkbox">
                <input type="checkbox" id="chkCompartido" @bind="gastoForm.EsGastoCompartido" />
                <label for="chkCompartido">👥 Compartir con mi pareja</label>
            </div>
        }
        *@

    </Body>
    <Footer>
        <button class="btn-footer btn-cancelar" @onclick="CerrarModal">Cancelar</button>
        <button class="btn-footer btn-guardar" @onclick="GuardarGastoAsync" disabled="@(!FormularioValido || guardando)">
            @(guardando ? "Guardando..." : "Guardar")
        </button>
    </Footer>
</Modal>

<Modal Title="Transacciones recurrentes" Visible="@modalRecurrenciasAbierto" OnClose="CerrarModalRecurrencias">
    <Body>
        @if (recurrencias is null)
        {
            <LoadingSpinner Message="Cargando..." />
        }
        else if (!recurrencias.Any())
        {
            <EmptyState Icon="🔄" Title="Sin recurrentes" Subtitle="Crea una para automatizar gastos o ingresos periódicos" />
        }
        else
        {
            <div class="recurrencias-lista">
                @foreach (var rec in recurrencias.OrderBy(r => r.ProximaFecha))
                {
                    <div @key="rec.Id" class="recurrencia-item @(!rec.Activa ? "recurrencia-inactiva" : "")">
                        <div class="recurrencia-icono" style="background: @(ObtenerColorCategoria(rec.CategoriaId ?? Guid.Empty) + "22")">
                            @ObtenerIconoCategoria(rec.CategoriaId ?? Guid.Empty)
                        </div>
                        <div class="recurrencia-info">
                            <div class="recurrencia-categoria">@ObtenerNombreCategoria(rec.CategoriaId ?? Guid.Empty)</div>
                            <div class="recurrencia-desc">@(rec.Descripcion ?? LabelRecurrencia(rec))</div>
                            <div class="recurrencia-prox">Próxima: @SafeLocalTime(rec.ProximaFecha).ToString(mostrarMinutos ? "dd MMM yyyy HH:mm" : "dd MMM yyyy")</div>
                        </div>
                        <div class="recurrencia-monto @(rec.Monto >= 0 ? "monto-gasto" : "monto-ingreso")">@FormatearMonto(rec.Monto)</div>
                        <div class="gasto-acciones">
                            <button class="accion-btn" @onclick="() => EditarRecurrencia(rec)" title="Editar">✏️</button>
                            <button class="accion-btn accion-eliminar" @onclick="() => ConfirmarEliminarRecurrencia(rec.Id)" title="Eliminar">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        }
    </Body>
    <Footer>
        <button class="btn-footer btn-guardar" @onclick="AbrirModalNuevaRecurrencia">➕ Nueva recurrencia</button>
        <button class="btn-footer btn-cancelar" @onclick="CerrarModalRecurrencias">Cerrar</button>
    </Footer>
</Modal>

<Modal Title="@(editandoRecurrencia ? "Editar recurrencia" : "Nueva recurrencia")" Visible="@modalRecurrenciaFormAbierto" OnClose="CerrarModalRecurrenciaForm">
    <Body>
        <div class="tipo-toggle">
            <button class="tipo-btn @((recurrenciaFormMonto ?? 0) >= 0 ? "tipo-activo tipo-gasto" : "")"
                    @onclick="() => { recurrenciaFormMonto = Math.Abs(recurrenciaFormMonto ?? 0); }">
                💸 Gasto
            </button>
            <button class="tipo-btn @((recurrenciaFormMonto ?? 0) < 0 ? "tipo-activo tipo-ingreso" : "")"
                    @onclick="() => { recurrenciaFormMonto = -Math.Abs(recurrenciaFormMonto ?? 0); }">
                💰 Ingreso
            </button>
        </div>

        <div class="campo">
            <label class="campo-label">Categoría</label>
            <div class="categoria-grid">
                @foreach (var cat in categorias)
                {
                    <div class="categoria-item @(recurrenciaFormCategoriaId == cat.Id ? "cat-seleccionada" : "")"
                         style="--cat-color: @cat.Color"
                         @onclick="() => recurrenciaFormCategoriaId = cat.Id">
                        <span class="cat-icono">@cat.Icono</span>
                        <span class="cat-nombre">@cat.Nombre</span>
                    </div>
                }
            </div>
        </div>

        <div class="campo">
            <label class="campo-label">Monto</label>
            <div class="monto-input-wrapper">
                <span class="monto-simbolo">$</span>
                <input type="number" class="monto-input" @bind="recurrenciaFormMontoAbs" step="0.01" min="0.01" placeholder="0.00" />
            </div>
        </div>

        <div class="campo">
            <label class="campo-label">Descripción <span class="campo-opcional">(opcional)</span></label>
            <input type="text" class="campo-input" @bind="recurrenciaFormDesc" placeholder="Ej: Renta, Netflix, Salario" />
        </div>

        <div class="campo">
            <label class="campo-label">Periodo</label>
            <div class="periodo-toggle" style="display:flex;gap:0.5rem;">
                @foreach (var (val, lbl) in new[] { ("Diario", "Cada día"), ("Semanal", "Cada semana"), ("Mensual", "Cada mes"), ("Anual", "Cada año") })
                {
                    <button class="periodo-btn @(recurrenciaFormPeriodo == val ? "periodo-activo" : "")"
                            @onclick="() => recurrenciaFormPeriodo = val">
                        @lbl
                    </button>
                }
            </div>
        </div>

        <div class="campo">
            <label class="campo-checkbox">
                <input type="checkbox" @bind="recurrenciaFormActiva" />
                <span>Activa</span>
            </label>
        </div>
    </Body>
    <Footer>
        <button class="btn-footer btn-cancelar" @onclick="CerrarModalRecurrenciaForm">Cancelar</button>
        <button class="btn-footer btn-guardar" @onclick="GuardarRecurrenciaAsync" disabled="@(!RecurrenciaFormValida || guardandoRecurrencia)">
            @(guardandoRecurrencia ? "Guardando..." : "Guardar")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="@(gastoEliminando is not null)"
               Icon="⚠️"
               Title="¿Eliminar este gasto?"
               Message="@mensajeEliminar"
               CancelText="Cancelar"
               ConfirmText="Eliminar"
               OnCancel="CancelarEliminar"
               OnConfirm="EliminarGastoAsync" />

@if (recurrenciaEliminandoId is not null)
{
    <div class="confirm-overlay" @onclick="CancelarEliminarRecurrencia">
        <div class="recurrencia-confirm" @onclick:stopPropagation>
            <div class="recurrencia-confirm-icon">⚠️</div>
            <div class="recurrencia-confirm-title">¿Eliminar esta recurrencia?</div>
            <div class="recurrencia-confirm-msg">¿Qué hacer con los gastos que generó?</div>
            <div class="recurrencia-confirm-btns">
                <button class="btn-confirm btn-keep" @onclick="EliminarRecurrenciaAsync">
                    Conservar gastos anteriores
                </button>
                <button class="btn-confirm btn-delete-all" @onclick="EliminarRecurrenciaConGastosAsync">
                    Eliminar también los gastos
                </button>
                <button class="btn-confirm btn-cancel" @onclick="CancelarEliminarRecurrencia">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Gasto> gastos = new();
    private List<Categoria> categorias = new();
    private Usuario? usuario;
    private bool mostrarMinutos;
    // Comentado: hogar fields — proximamente
    // private List<HogarMiembro> miembrosHogar = new();
    // private Dictionary<Guid, HogarMiembro> miembrosPorUsuarioId = new();
    // private Dictionary<string, HogarMiembro> miembrosPorEmail = new();

    private bool EsMesActual => mesSeleccionado == DateTime.Now.Month && añoSeleccionado == DateTime.Now.Year;
    private int añoSeleccionado = DateTime.Now.Year;
    private int mesSeleccionado = DateTime.Now.Month;

    private decimal totalGastos;
    private decimal totalIngresos;
    private decimal balanceAcumulado;
    private decimal balanceMes => totalIngresos - totalGastos;

    private bool modalAbierto;
    private bool editando;
    private Gasto gastoForm = new();
    private decimal? gastoFormMonto;
    private string tipoForm = "Gasto";
    private bool guardando;
    private bool montoTocado;
    private DateTime fechaForm = DateTime.Now;

    private Guid? gastoEliminando;

    private string mensajeEliminar
    {
        get
        {
            if (gastoEliminando is null) return "";
            var g = gastos.FirstOrDefault(x => x.Id == gastoEliminando);
            if (g?.Monto < 0 && g?.Descripcion == "Fondos para presupuesto")
                return "⚠️ Este ingreso está vinculado a un presupuesto. Al eliminarlo, el límite se reducirá automáticamente.";
            return "Esta acción no se puede deshacer";
        }
    }

    private string filtroBusqueda = "";
    private string filtroTipo = "Todos";
    // private string filtroCompartido = "Todos"; // Comentado — hogar
    private Guid? filtroCategoriaId;
    private bool filtrosVisibles;
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private bool modoRango;
    private List<(DateTime Fecha, List<Gasto> Gastos)> gastosFiltrados = new();
    private CancellationTokenSource? ctsCarga;
    private bool exportMenuAbierto;
    private bool exportando;

    private List<Categoria> categoriasFiltro => filtroTipo switch
    {
        "Gasto" => categorias.Where(c => c.Tipo == TipoGasto.Gasto).OrderBy(c => c.Orden).ToList(),
        "Ingreso" => categorias.Where(c => c.Tipo == TipoGasto.Ingreso).OrderBy(c => c.Orden).ToList(),
        _ => categorias.OrderBy(c => c.Orden).ToList(),
    };

    private void AplicarFiltros()
    {
        if (gastosAgrupados is null || !gastosAgrupados.Any())
        {
            gastosFiltrados = new();
            return;
        }

        var enumerable = gastosAgrupados.SelectMany(g => g.Gastos).AsEnumerable();

        if (filtroTipo != "Todos")
        {
            var buscarGasto = filtroTipo == "Gasto";
            enumerable = enumerable.Where(g => buscarGasto ? g.Monto > 0 : g.Monto < 0);
        }

        if (filtroCategoriaId.HasValue)
        {
            enumerable = enumerable.Where(g => g.CategoriaId == filtroCategoriaId.Value);
        }

        if (!string.IsNullOrWhiteSpace(filtroBusqueda))
        {
            var termino = filtroBusqueda.Trim().ToLowerInvariant();
            enumerable = enumerable.Where(g =>
                g.Descripcion?.ToLowerInvariant().Contains(termino) == true);
        }

        // Comentado: filtro compartido — proximamente
        // if (filtroCompartido != "Todos")
        // {
        //     var buscarCompartido = filtroCompartido == "Compartidos";
        //     enumerable = enumerable.Where(g => g.EsGastoCompartido == buscarCompartido);
        // }

        if (filtroFechaDesde.HasValue)
            enumerable = enumerable.Where(g => g.Fecha.ToLocalTime().Date >= filtroFechaDesde.Value.Date);
        if (filtroFechaHasta.HasValue)
            enumerable = enumerable.Where(g => g.Fecha.ToLocalTime().Date <= filtroFechaHasta.Value.Date);

        gastosFiltrados = enumerable
            .GroupBy(g => g.Fecha.ToLocalTime().Date)
            .OrderByDescending(g => g.Key)
            .Select(g => (Fecha: g.Key, Gastos: g.OrderByDescending(x => x.Fecha).ToList()))
            .ToList();
    }

    private async Task OnFechaDesdeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val))
            filtroFechaDesde = null;
        else if (DateTime.TryParse(val, out var parsed))
            filtroFechaDesde = parsed;
        await AplicarRangoAsync();
    }

    private async Task OnFechaHastaChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val))
            filtroFechaHasta = null;
        else if (DateTime.TryParse(val, out var parsed))
            filtroFechaHasta = parsed;
        await AplicarRangoAsync();
    }

    private async Task AplicarRangoAsync()
    {
        if (filtroFechaDesde.HasValue && filtroFechaHasta.HasValue && filtroFechaDesde <= filtroFechaHasta)
        {
            modoRango = true;
            var oldCts = ctsCarga;
            ctsCarga?.Cancel();
            ctsCarga = new CancellationTokenSource();
            oldCts?.Dispose();
            await CargarGastosAsync(ctsCarga.Token);
        }
        else
        {
            modoRango = false;
            AplicarFiltros();
        }
        StateHasChanged();
    }

    private async Task LimpiarRango()
    {
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        modoRango = false;
        var oldCts = ctsCarga;
        ctsCarga?.Cancel();
        ctsCarga = new CancellationTokenSource();
        oldCts?.Dispose();
        await CargarGastosAsync(ctsCarga.Token);
    }

