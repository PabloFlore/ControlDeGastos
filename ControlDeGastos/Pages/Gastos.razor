    private async Task CargarGastosAsync(CancellationToken ct = default)
    {
        try
        {
            var paginacion = new Paginacion { Pagina = paginaActual, TamanoPagina = 50 };
            var filtro = new FiltroGasto
            {
                Year = añoSeleccionado,
                Month = mesSeleccionado,
                Desde = filtroFechaDesde,
                Hasta = filtroFechaHasta
            };

            var resultado = await GastoService.ObtenerGastosPaginadoAsync(paginacion, filtro);
            ct.ThrowIfCancellationRequested();

            gastos = resultado.Items;
            totalPaginas = resultado.TotalPaginas;
            totalGastos = gastos.Where(g => g.Monto > 0).Sum(g => g.Monto);
            totalIngresos = gastos.Where(g => g.Monto < 0).Sum(g => Math.Abs(g.Monto));

            var todosGastos = await GastoService.ObtenerGastosAsync();
            var finDelMes = new DateTime(añoSeleccionado, mesSeleccionado, 1).AddMonths(1).AddTicks(-1);
            var gastosAcum = todosGastos.Where(g =>
            {
                var f = g.Fecha.Kind == DateTimeKind.Utc ? g.Fecha.ToLocalTime() : g.Fecha;
                return f <= finDelMes && g.Monto > 0;
            }).Sum(g => g.Monto);
            var ingresosAcum = todosGastos.Where(g =>
            {
                var f = g.Fecha.Kind == DateTimeKind.Utc ? g.Fecha.ToLocalTime() : g.Fecha;
                return f <= finDelMes && g.Monto < 0;
            }).Sum(g => Math.Abs(g.Monto));
            balanceAcumulado = ingresosAcum - gastosAcum;

            var agrupados = gastos
                .OrderByDescending(g => g.Fecha)
                .GroupBy(g => g.Fecha.ToLocalTime().Date)
                .Select(g => (Fecha: g.Key, Gastos: g.ToList()))
                .ToList();

            gastosAgrupados = agrupados;
            AplicarFiltros();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar los gastos: {ex.Message}");
            gastosAgrupados = new();
        }

        StateHasChanged();
    }

