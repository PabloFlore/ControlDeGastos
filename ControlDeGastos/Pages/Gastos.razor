    private async Task EliminarGastoAsync()
    {
        if (gastoEliminando is null) return;

        try
        {
            var eliminado = gastos.FirstOrDefault(g => g.Id == gastoEliminando.Value);
            await GastoService.EliminarGastoAsync(gastoEliminando.Value);

            if (eliminado?.Monto < 0 && eliminado?.Descripcion == "Fondos para presupuesto")
            {
                var catId = eliminado.CategoriaId == Guid.Empty ? null : (Guid?)eliminado.CategoriaId;
                var presupuestos = await PresupuestoService.ObtenerPresupuestosAsync();
                var presupuesto = presupuestos.FirstOrDefault(p =>
                    p.CategoriaId == catId);
                if (presupuesto is not null)
                {
                    var monto = Math.Abs(eliminado.Monto);
                    presupuesto.MontoLimite = Math.Max(0, presupuesto.MontoLimite - monto);
                    await PresupuestoService.ActualizarPresupuestoAsync(presupuesto);
                    ToastService.ShowInfo($"📉 Límite del presupuesto reducido en ${monto:N2}");
                }
            }

            ToastService.ShowSuccess(eliminado?.Monto < 0 ? "Ingreso eliminado" : "Gasto eliminado");
            CancelarEliminar();

            usuario = await UsuarioService.ObtenerUsuarioAsync();
            if (usuario?.ModoGamificadoActivo == true)
            {
                await GamificacionService.RecalcularDesdeCeroAsync();
            }

            await CargarGastosAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al eliminar: {ex.Message}");
        }
    }

