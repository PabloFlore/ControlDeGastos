    // Exportar / Importar datos

    private bool exportando;
    private bool importando;
    private bool mostrarConfirmacionImportacion;
    private ResultadoImportacion? resultadoPreview;
    private byte[]? archivoImportar;

    private async Task ExportarDatosAsync()
    {
        exportando = true;
        StateHasChanged();

        try
        {
            var bytes = await ExportImportService.ExportarDatosAsync();
            var json = System.Text.Encoding.UTF8.GetString(bytes);
            var nombre = $"ControlDeGastos_{DateTime.Now:yyyy-MM-dd}.json";
            await JS.InvokeVoidAsync("descargarArchivo", nombre, json, "application/json");
            ToastService.ShowSuccess("Datos exportados correctamente");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al exportar: {ex.Message}");
        }

        exportando = false;
    }

    private async Task TriggerImportar()
    {
        await JS.InvokeVoidAsync("importFileInputClick");
    }

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        try
        {
            importando = true;
            StateHasChanged();

            var json = await JS.InvokeAsync<string>("leerArchivoJson");

            if (string.IsNullOrEmpty(json))
            {
                ToastService.ShowError("No se pudo leer el archivo");
                return;
            }

            archivoImportar = System.Text.Encoding.UTF8.GetBytes(json);
            resultadoPreview = await ExportImportService.ImportarDatosAsync(archivoImportar);

            if (!resultadoPreview.Exito)
            {
                ToastService.ShowError(resultadoPreview.Mensaje ?? "Error al procesar el archivo");
                return;
            }

            mostrarConfirmacionImportacion = true;
        }
        catch (JSException)
        {
            // Usuario canceló la selección, no mostrar error
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al leer archivo: {ex.Message}");
        }

        importando = false;
    }

    private async Task ConfirmarImportacion()
    {
        mostrarConfirmacionImportacion = false;
        importando = true;
        StateHasChanged();

        try
        {
            if (archivoImportar is null) return;

            var resultado = await ExportImportService.ImportarDatosAsync(archivoImportar);

            if (resultado.Exito)
            {
                ToastService.ShowSuccess(resultado.Mensaje ?? "Datos importados");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                ToastService.ShowError(resultado.Mensaje ?? "Error al importar");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al importar: {ex.Message}");
        }

        archivoImportar = null;
        importando = false;
    }

    private void CancelarImportacion()
    {
        mostrarConfirmacionImportacion = false;
        resultadoPreview = null;
        archivoImportar = null;
    }

    // Bloqueo PIN

    private bool pinConfigurado;
    private string pinDelayInput = "30";

    private bool mostrarModalPin;
    private bool modalPinConfigurar;
    private bool modalPinCambiar;
    private bool modalPinEliminar;
    private string modalPinTitulo = "";
    private string modalPinMensaje = "";
    private string modalPinInput1 = "";
    private string modalPinInput2 = "";
    private string? modalPinError;

    private void MostrarModalConfigurarPin()
    {
        modalPinConfigurar = true;
        modalPinCambiar = false;
        modalPinEliminar = false;
        modalPinTitulo = "Configurar PIN";
        modalPinMensaje = "Ingresa un PIN de 4 dígitos para proteger tus datos.";
        modalPinInput1 = "";
        modalPinInput2 = "";
        modalPinError = null;
        mostrarModalPin = true;
    }

    private void MostrarModalCambiarPin()
    {
        modalPinConfigurar = false;
        modalPinCambiar = true;
        modalPinEliminar = false;
        modalPinTitulo = "Cambiar PIN";
        modalPinMensaje = "Ingresa tu PIN actual y el nuevo PIN.";
        modalPinInput1 = "";
        modalPinInput2 = "";
        modalPinError = null;
        mostrarModalPin = true;
    }

    private void MostrarModalEliminarPin()
    {
        modalPinConfigurar = false;
        modalPinCambiar = false;
        modalPinEliminar = true;
        modalPinTitulo = "Eliminar PIN";
        modalPinInput1 = "";
        modalPinInput2 = "";
        modalPinError = null;
        mostrarModalPin = true;
    }

    private void CancelarPinModal()
    {
        mostrarModalPin = false;
        modalPinInput1 = "";
        modalPinInput2 = "";
        modalPinError = null;
        modalPinRecuperando = false;
    }

    private void IniciarRecuperacionEliminar()
    {
        modalPinRecuperando = true;
        modalPinError = null;
        modalPinInput1 = "";
    }

    private void CerrarRecoveryCodeModal()
    {
        mostrarRecoveryCode = false;
        ToastService.ShowSuccess("PIN configurado correctamente");
    }

    private async Task EjecutarAccionPinAsync()
    {
        modalPinError = null;

        try
        {
            if (modalPinEliminar)
            {
                if (modalPinRecuperando)
                {
                    await PinLockService.DesactivarConRecoveryCodeAsync(modalPinInput1);
                    pinConfigurado = false;
                    CancelarPinModal();
                    ToastService.ShowSuccess("PIN eliminado correctamente");
                    return;
                }

                if (string.IsNullOrWhiteSpace(modalPinInput1) || modalPinInput1.Length != 4 || !modalPinInput1.All(char.IsDigit))
                {
                    modalPinError = "Ingresa tu PIN actual de 4 dígitos.";
                    return;
                }
                await PinLockService.DesactivarPinAsync(modalPinInput1);
                pinConfigurado = false;
                CancelarPinModal();
                ToastService.ShowSuccess("PIN eliminado correctamente");
            }
            else if (modalPinCambiar)
            {
                if (string.IsNullOrWhiteSpace(modalPinInput1) || modalPinInput1.Length != 4 || !modalPinInput1.All(char.IsDigit))
                {
                    modalPinError = "Ingresa tu PIN actual de 4 dígitos.";
                    return;
                }
                if (string.IsNullOrWhiteSpace(modalPinInput2) || modalPinInput2.Length != 4 || !modalPinInput2.All(char.IsDigit))
                {
                    modalPinError = "El nuevo PIN debe tener exactamente 4 dígitos numéricos.";
                    return;
                }
                await PinLockService.CambiarPinAsync(modalPinInput1, modalPinInput2);
                CancelarPinModal();
                ToastService.ShowSuccess("PIN cambiado correctamente");
            }
            else if (modalPinConfigurar)
            {
                if (modalPinInput1.Length != 4 || !modalPinInput1.All(char.IsDigit))
                {
                    modalPinError = "El PIN debe tener exactamente 4 dígitos numéricos.";
                    return;
                }
                if (modalPinInput1 != modalPinInput2)
                {
                    modalPinError = "Los PIN no coinciden. Intenta de nuevo.";
                    return;
                }
                await PinLockService.ConfigurarPinAsync(modalPinInput1);
                pinConfigurado = true;
                CancelarPinModal();
                var recoveryCode = await PinLockService.GenerarRecoveryCodeSiNoExisteAsync();
                if (recoveryCode is not null)
                {
                    recoveryCodeTexto = recoveryCode;
                    mostrarRecoveryCode = true;
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowSuccess("PIN configurado correctamente");
                }
            }
        }
        catch (Exception ex)
        {
            modalPinError = ex.Message;
        }
    }

    private async Task GuardarDelayPinAsync(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? "30";
        pinDelayInput = valor;
        if (int.TryParse(valor, out var segundos))
        {
            await PinLockService.GuardarDelayBloqueoSegundosAsync(segundos);
            ToastService.ShowSuccess("Tiempo de auto-bloqueo actualizado");
        }
    }

    private async Task EjecutarForzarRecargaAsync()
    {
        mostrarConfirmRecarga = false;
        recargando = true;
        StateHasChanged();
        await UpdateService.ForzarRecargaAsync();
    }

